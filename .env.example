# Frontend: leave blank for same-origin /api routes.
# In local development, localhost automatically targets http://localhost:3001.
# For a separately hosted backend, set its public origin here.
VITE_API_BASE_URL=

# Backend
PORT=3001
CORS_ORIGINS=http://localhost:5173

# Gemini image and text generation. Alternatively, configure OPENROUTER_API_KEY.
GEMINI_API_KEY=

# MySQL connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=storybook_generator
